<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="GPUI example" phx-no-format>{assigns[:page_title]}</.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/default.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <style>
      html, body { height: 100%; margin: 0; }
      canvas { width: 100%; height: 100%; display: block; }
      #rekindle-error { box-sizing: border-box; padding: 1rem; white-space: pre-wrap; }
    </style>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
